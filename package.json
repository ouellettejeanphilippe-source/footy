{
  "name": "guide-des-sports",
  "version": "1.0.0",
  "private": true,
  "description": "Guide des Sports : grille télé des matchs du jour (PWA) avec liens de diffusion et lecteur multivision.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npx playwright test tests/test_app_boot.spec.js tests/test_cleaner.spec.js tests/test_rattrapage.spec.js tests/test_extension.spec.js",
    "test:unit": "node --test tests/*.test.js",
    "scrape:streams": "node --max-old-space-size=8192 scripts/scrape_streams.mjs",
    "liens": "node scripts/maj_liens.mjs",
    "sonder": "node scripts/sonder_domaine.mjs",
    "test:domains": "npx playwright test tests/test_domains.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "26.1.0",
    "playwright": "^1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouellettejeanphilippe-source/footy.git"
  },
  "bugs": {
    "url": "https://github.com/ouellettejeanphilippe-source/footy/issues"
  },
  "homepage": "https://github.com/ouellettejeanphilippe-source/footy#readme"
}
