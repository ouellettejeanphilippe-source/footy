<?xml version="1.0" encoding="utf-8"?>
<!-- La bannière du lanceur Google TV (320 × 180 dp) : le logo de l'application sur fond sombre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#FF0F172A" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp" android:drawable="@drawable/logo" />
</layer-list>
